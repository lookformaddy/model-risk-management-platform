# Copy to .env; no secrets are required to run the demo.
# All data is synthetic and generated in-process.
MRMP_HOST=0.0.0.0
MRMP_PORT=8000
MRMP_SEED=42
MRMP_N_TRAIN=2000
MRMP_N_VALIDATE=2000
# Demo-grade approval-signing secret. Set a real one in production.
MRMP_APPROVAL_SECRET=mrmp-demo-secret-change-me
MRMP_PSI_THRESHOLD=0.2
MRMP_KS_THRESHOLD=0.15
MRMP_ACCURACY_FLOOR=0.70
MRMP_AUC_FLOOR=0.70
